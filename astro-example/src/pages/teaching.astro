---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';

const heroStats = [
  { number: "21+", label: "Courses" },
  { number: "10", label: "Years" },
  { number: "500+", label: "Students" }
];

const courses = [
  {
    title: "Modern Physics (PH110)",
    level: "Undergraduate Core",
    description: "Foundation course in quantum mechanics and special relativity. Led comprehensive curriculum revision in 2018.",
    period: "2013-2023",
    highlight: "MCQ Assessment Pioneer"
  },
  {
    title: "Quantum Computation (PH870)",
    level: "M.Sc. Elective",
    description: "Original course development covering quantum algorithms and quantum information theory.",
    period: "2021-2022",
    highlight: "New Course Development"
  },
  {
    title: "General Relativity (PH863/876)",
    level: "M.Sc. Advanced",
    description: "Complete course development in Einstein's field equations and applications.",
    period: "2014-2019",
    highlight: "Original Curriculum"
  }
];

const philosophyItems = [
  {
    icon: "fas fa-lightbulb",
    title: "Conceptual Understanding",
    description: "Emphasis on building intuition and understanding fundamental principles rather than rote learning."
  },
  {
    icon: "fas fa-code",
    title: "Computational Integration",
    description: "Integration of numerical methods and programming to enhance problem-solving capabilities."
  },
  {
    icon: "fas fa-users",
    title: "Interactive Learning",
    description: "Encouraging student participation through discussions, presentations, and collaborative problem-solving."
  },
  {
    icon: "fas fa-chart-line",
    title: "Continuous Assessment",
    description: "Regular evaluation through quizzes, assignments, and feedback to track student progress."
  }
];
---

<Layout title="Teaching Portfolio - Deepak Vaid" description="Physics education at NITK Karnataka (2013-2023)">
  <HeroSection 
    title="Teaching Portfolio"
    subtitle="Physics education at NITK Karnataka (2013-2023)"
    stats={heroStats}
  />

  <!-- Course Portfolio -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">Course Portfolio</h2>
      <div class="course-grid">
        {courses.map(course => (
          <div class="course-card">
            <h3>{course.title}</h3>
            <p class="course-level">{course.level}</p>
            <p>{course.description}</p>
            <div class="course-details">
              <span>{course.period}</span>
              <span>{course.highlight}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Teaching Philosophy -->
  <section class="section section-alt">
    <div class="container">
      <h2 class="section-title">Teaching Approach</h2>
      <div class="philosophy-grid">
        {philosophyItems.map(item => (
          <div class="philosophy-card">
            <i class={item.icon}></i>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Course Portfolio Styles */
  .course-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 30px;
    margin-top: 40px;
  }

  .course-card {
    background: var(--card-bg);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border-color);
    padding: 30px;
    border-radius: 12px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    transition: all 0.3s ease;
  }

  .course-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(0,0,0,0.15);
  }

  .course-card h3 {
    color: var(--secondary-color);
    margin-bottom: 10px;
    font-size: 1.3rem;
  }

  .course-level {
    color: var(--accent-color);
    font-weight: 600;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 15px;
  }

  .course-details {
    display: flex;
    justify-content: space-between;
    margin-top: 20px;
    padding-top: 15px;
    border-top: 1px solid var(--border-color);
    font-size: 0.9rem;
    color: var(--text-light);
  }

  /* Philosophy Grid Styles */
  .philosophy-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 30px;
    margin-top: 40px;
  }

  .philosophy-card {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.05) 100%);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 30px;
    border-radius: 12px;
    text-align: center;
    transition: all 0.3s ease;
  }

  .philosophy-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(0,0,0,0.1);
  }

  .philosophy-card i {
    font-size: 2.5rem;
    color: var(--secondary-color);
    margin-bottom: 20px;
    display: block;
  }

  .philosophy-card h3 {
    margin-bottom: 15px;
    font-size: 1.2rem;
    color: white;
  }

  .philosophy-card p {
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.6;
  }

  /* Dark theme adjustments */
  :global(body.dark-theme) .course-card {
    box-shadow: 0 5px 15px rgba(0,0,0,0.3);
  }

  :global(body.dark-theme) .course-card:hover {
    box-shadow: 0 15px 30px rgba(0,0,0,0.4);
  }

  @media (max-width: 768px) {
    .course-grid {
      grid-template-columns: 1fr;
    }
    
    .course-details {
      flex-direction: column;
      gap: 10px;
    }
    
    .philosophy-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
